class Solution {
    public Pair<Node, Node> splitList(Node head) {
        // Code here
        Node head1 = null ;
        Node head2 = null ;
        Node slow =  head ;
        Node fast =  head ;
        
        while(fast.next!=head && fast.next.next!=head){
            slow = slow.next;
            fast =  fast.next.next;
        }
        head2 = slow.next;
        head1 = head ;
        slow.next = head1 ;
        if(fast.next == head){
            fast.next = head2;
        }
        else{
            fast.next.next = head2;
        }
        return new Pair<>(head1,head2);
    }
}
