class Solution {
    public int longestKSubstr(String s, int k) {
        // code here
        HashMap <Char,Integer> map = new HashMap<>();
        int left = 0 ;
        int right = 0 ;
        int maxlen = 0 ;
        
        while(right<s.length){
            
            char ch = s.charAt(right) ;
            map.put(ch,map.getOrDefault(right,0)+1);
            
            while(map.size()>k){
                char leftch = s.charAt(left) ;
                map.put(ch,map.get(leftch)-1);    
                if(map.get(ch) == 0){
                    map.remove(ch);
                }
                    left ++;
            }
            if(map.size(right) == k){
                maxlen = Math.max(maxlen,right-left+1);
            }
            right++;
        }
    }
}
