import java.util.*;
import java.lang.*;


class Solution {
public static int shortestWayToFormString(String source, String target) {

    Set<Character> set = new HashSet<>();

    for (int i = 0; i < source.length(); i++) {
        set.add(source.charAt(i));
    }

    // If target contains a character not present in source
    // it can never be formed.
    for (int i = 0; i < target.length(); i++) {
        if (!set.contains(target.charAt(i))) {
            return -1;
        }
    }

    int i = 0; // source pointer
    int j = 0; // target pointer
    int count = 0;

    while (j < target.length()) {

        i = 0;
        count++;

        while (i < source.length() && j < target.length()) {

            if (source.charAt(i) == target.charAt(j)) {
                i++;
                j++;
            } else {
                i++;
            }
        }
    }

    return count;
}
}

