class Solution {

    int heapsize;

    // Function to sort an array using Heap Sort.
    public void heapSort(int arr[]) {

        heapsize = arr.length;

        firstBuildheaptree(arr);

        //after first top element found build the sorted array
        for (int i = 0; i < arr.length - 1; i++) {
            maxsort(arr);
        }
    }

    //Find first top element
    //Impleamentations
    public void firstBuildheaptree(int arr[]) {

        for (int i = heapsize / 2 - 1; i >= 0; i--) {
            heapify(i, arr);
        }
    }

    public void maxsort(int arr[]) {

        if (heapsize == 0) {
            return;
        }

        int max = arr[0];
        arr[0] = arr[heapsize - 1];
        arr[heapsize - 1] = max;   

        heapsize--;

        heapify(0, arr);           
    }

    public void heapify(int i, int arr[]) {

        int max = i;

        int left = 2 * i + 1;
        int right = 2 * i + 2;

        if (left < heapsize && arr[left] > arr[max]) {
            max = left;            // Fixed: store index
        }

        if (right < heapsize && arr[right] > arr[max]) {
            max = right;           // Fixed: store index
        }

        if (max != i) {
            swap(max, i, arr);
            heapify(max, arr);     // Fixed recursive call
        }
    }

    public void swap(int one, int two, int arr[]) {
        int temp = arr[one];
        arr[one] = arr[two];
        arr[two] = temp;
    }
}
