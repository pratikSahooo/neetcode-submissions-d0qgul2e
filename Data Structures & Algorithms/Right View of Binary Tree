/*
Definition for Node
class Node {
    int data;
    Node left, right;

    Node(int val) {
        this.data = val;
        this.left = null;
        this.right = null;
    }
}
*/

class Solution {
    public ArrayList<Integer> rightView(Node root) {
        // code here
        ArrayList<Integer>list = new ArrayList<>();
        Queue<Node> q = new LinkedList<>();
        q.offer(root);
        while(!q.isEmpty()){
            int size = q.size();
            while(size>0){
                Node poped = q.poll();
                if(poped.left!=null){
                    q.offer(poped.left);
                }
                if(poped.right!=null){
                    q.offer(poped.right);
                }
                size--;
                if(size == 1){
                    list.add(poped.data);
                }
            }
        }
        return list;
    }
}
