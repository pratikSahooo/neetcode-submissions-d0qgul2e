class TreeNode {
    int val;
    TreeNode left, right;

    TreeNode(int val) {
        this.val = val;
    }
}

public void insert(TreeNode root, int val) {
    Queue<TreeNode> q = new LinkedList<>();
    q.offer(root);

    while (!q.isEmpty()) {
        TreeNode curr = q.poll();

        if (curr.left == null) {
            curr.left = new TreeNode(val);
            return;
        } else {
            q.offer(curr.left);
        }

        if (curr.right == null) {
            curr.right = new TreeNode(val);
            return;
        } else {
            q.offer(curr.right);
        }
    }
}
